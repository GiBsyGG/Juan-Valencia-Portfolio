<header class="header">
	<nav class="nav" aria-label="Principal">
		<a class="brand" href="#hero">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF00FF" stroke-width="1.5" aria-hidden="true"><rect x="2.5" y="4" width="19" height="16" rx="1"></rect><path d="M7 9l3 3-3 3"></path><path d="M12.5 15h4.5"></path></svg>
			<span>~/[tu-nombre]<span class="caret">_</span></span>
		</a>
		<div class="links">
			<a class="link" data-section="proyectos" href="#proyectos"><span class="num">01.</span>proyectos</a>
			<a class="link" data-section="laboratorio" href="#laboratorio"><span class="num">02.</span>laboratorio</a>
			<a class="link" data-section="contacto" href="#contacto"><span class="num">03.</span>contacto</a>
			<a class="btn cv" href="[URL-CV]">./cv.pdf</a>
		</div>
		<button class="btn menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label="Abrir menú">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h10"></path></svg>
			<span class="menu-label">menú</span>
		</button>
	</nav>
	<div class="panel" id="menu-panel" hidden>
		<a href="#proyectos">&gt; 01.proyectos</a>
		<a href="#laboratorio">&gt; 02.laboratorio</a>
		<a href="#contacto">&gt; 03.contacto</a>
		<a href="[URL-CV]">&gt; ./cv.pdf</a>
	</div>
</header>

<script>
	const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
	const panel = document.getElementById('menu-panel');
	const label = btn?.querySelector<HTMLElement>('.menu-label');

	function setOpen(open: boolean) {
		if (!btn || !panel || !label) return;
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		label.textContent = open ? 'cerrar' : 'menú';
		panel.hidden = !open;
	}

	btn?.addEventListener('click', () => {
		setOpen(btn.getAttribute('aria-expanded') !== 'true');
	});

	panel?.querySelectorAll('a').forEach((a) => {
		a.addEventListener('click', () => setOpen(false));
	});
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(9, 9, 11, 0.86);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
		font-family: var(--font-mono);
	}

	.nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(20px, 5vw, 64px);
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}

	a {
		color: var(--fg-soft);
		text-decoration: none;
	}

	a:hover {
		color: var(--accent);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--fg);
		font-size: 15px;
		font-weight: 500;
	}

	.caret {
		color: var(--accent);
		animation: blink 1s steps(1) infinite;
	}

	@keyframes blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	.links {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.link {
		padding: 8px 12px;
		font-size: 13px;
		transition: color 0.2s ease;
	}

	.link.is-active {
		color: var(--accent);
	}

	.num {
		opacity: 0.55;
	}

	.btn {
		color: var(--fg);
		border: 1px solid var(--border-soft);
		border-radius: 2px;
		font-family: var(--font-mono);
		font-size: 13px;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.btn:hover,
	.btn:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
		box-shadow: 0 0 18px rgba(255, 0, 255, 0.18);
	}

	.cv {
		margin-left: 12px;
		padding: 9px 14px;
	}

	.menu-btn {
		display: none;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 14px;
		background: transparent;
		cursor: pointer;
	}

	.panel {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--border);
		padding: 8px clamp(20px, 5vw, 64px) 16px;
		font-size: 14px;
	}

	.panel[hidden] {
		display: none;
	}

	.panel a {
		padding: 12px 0;
		border-bottom: 1px solid rgba(224, 255, 255, 0.08);
	}

	.panel a:last-child {
		border-bottom: 0;
	}

	@media (max-width: 820px) {
		.links {
			display: none;
		}

		.menu-btn {
			display: inline-flex;
		}
	}
</style>
