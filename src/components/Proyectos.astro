---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Proyecto {
	n: string;
	nombre: string;
	resumen: string;
	patron: string[];
	stack: string[];
	rol: string;
	genero: string;
	plataforma: string;
	imagen: string;
	alt: string;
	itchUrl?: string;
}

const proyectos: Proyecto[] = [
	{
		n: '01',
		nombre: 'Berracos Espantos',
		resumen:
			'Arquitectura de un videojuego en Unity. MVC separa datos, lógica e interfaz de cada componente. Una máquina de estados jerárquica (HSM) organiza el comportamiento de enemigos y jugadores. Object Pooling reutiliza objetos en lugar de crearlos y destruirlos constantemente, y los ScriptableObjects permiten configurar componentes sin tocar código.',
		patron: ['MVC', 'Máquina de estados jerárquica (HSM)', 'Object Pooling', 'ScriptableObjects'],
		stack: ['Unity', 'C#', 'Claude Code + Unity CLI'],
		rol: 'Desarrollador',
		genero: 'Videojuego',
		plataforma: 'PC',
		imagen: `${base}/images/projects/Berracos_Espantos.png`,
		alt: 'Captura de Berracos Espantos',
		itchUrl: 'https://monte-estudio.itch.io/berracos-espantos',
	},
	{
		n: '02',
		nombre: 'La Aventura Unal',
		resumen:
			'Videojuego para Android con arquitectura MVC, que separa datos, lógica e interfaz. Firebase guarda y sincroniza la información de los usuarios.',
		patron: ['MVC', 'ScriptableObjects', 'Object Pooling'],
		stack: ['Unity', 'C#'],
		rol: 'Desarrollador',
		genero: 'Videojuego',
		plataforma: 'Android',
		imagen: `${base}/images/projects/La_Aventura_UNAL.png`,
		alt: 'Captura de La Aventura Unal',
	},
	{
		n: '03',
		nombre: "Dead's Loot",
		resumen:
			'Generación procedural de mapas con distintas configuraciones. Combina Random Walk (recorrido aleatorio) y Binary Space Partitioning (división recursiva del espacio en zonas).',
		patron: ['Random Walk', 'Binary Space Partitioning', 'ScriptableObjects'],
		stack: ['Unity', 'C#'],
		rol: 'Desarrollador',
		genero: 'Videojuego',
		plataforma: 'PC',
		imagen: `${base}/images/projects/Deads_Loot.png`,
		alt: "Captura de Dead's Loot",
		itchUrl: 'https://gibsygg.itch.io/deads-loot',
	},
];

const [destacado, ...secundarios] = proyectos;
---

<section id="proyectos" aria-labelledby="proyectos-title" class="section">
	<div class="reveal inner">
		<div class="head">
			<div class="head-copy">
				<p class="eyebrow"><span class="num" data-section-num="proyectos">01</span> // proyectos_destacados</p>
				<h2 id="proyectos-title">Videojuegos como casos de estudio de ingeniería.</h2>
				<p class="lead">Cada proyecto se documenta por su arquitectura: el problema técnico, las decisiones de diseño y cómo se organizan los sistemas.</p>
			</div>
			<p class="eyebrow">{proyectos.length} proyectos</p>
		</div>

		<article class="card featured">
			<div class="diagram-col">
				
				<img
					class="shot-lg"
					src={destacado.imagen}
					alt={destacado.alt}
					width="1816"
					height="976"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="info-col">
				<div class="tab">
					<span class="file"><span class="tab-dot"></span>proyecto_{destacado.n}.md</span>
					<span>{destacado.genero} · {destacado.plataforma}</span>
				</div>
				<h3 class="title-lg">{destacado.nombre}</h3>
				<p class="body-lg">{destacado.resumen}</p>
				<dl class="meta meta-lg">
					<dt>patrones</dt><dd class="strong">{destacado.patron.join(' · ')}</dd>
					<dt>stack</dt><dd class="strong">{destacado.stack.join(' · ')}</dd>
					<dt>rol</dt><dd class="strong">{destacado.rol}</dd>
				</dl>
				{destacado.itchUrl && (
					<div class="actions">
						<a class="btn" href={destacado.itchUrl} target="_blank" rel="noopener noreferrer" aria-label={`Jugar ${destacado.nombre} en itch.io (abre en una pestaña nueva)`}>Jugar
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg></a>
					</div>
				)}
			</div>
		</article>

		<div class="grid">
			{secundarios.map((p) => (
				<article class="card compact">
					<div class="tab">
						<span class="file"><span class="tab-dot"></span>proyecto_{p.n}.md</span>
						<span>{p.genero} · {p.plataforma}</span>
					</div>
					<img
						class="shot"
						src={p.imagen}
						alt={p.alt}
						loading="lazy"
						decoding="async"
					/>
					<h3 class="title-md">{p.nombre}</h3>
					<p class="body-md">{p.resumen}</p>
					<details class="more">
						<summary>Detalles técnicos</summary>
						<dl class="meta">
							<dt>patrones</dt><dd>{p.patron.join(' · ')}</dd>
							<dt>stack</dt><dd>{p.stack.join(' · ')}</dd>
							<dt>rol</dt><dd>{p.rol}</dd>
						</dl>
					</details>
					{p.itchUrl && (
						<a class="btn push" href={p.itchUrl} target="_blank" rel="noopener noreferrer" aria-label={`Jugar ${p.nombre} en itch.io (abre en una pestaña nueva)`}>Jugar
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg></a>
					)}
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.section {
		padding: clamp(96px, 14vh, 160px) 0;
		border-top: 1px solid var(--border);
	}

	.inner {
		display: flex;
		flex-direction: column;
		gap: 56px;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
	}

	.head-copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 640px;
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--fg-muted);
	}

	.num.is-active {
		color: var(--accent);
	}

	h2 {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(30px, 4vw, 48px);
		line-height: 1.15;
		letter-spacing: -0.015em;
		color: var(--fg);
	}

	.lead {
		margin: 0;
		font-size: 17px;
		line-height: 1.65;
		color: var(--fg-soft);
	}

	.card {
		border: 1px solid var(--border);
		border-radius: 2px;
		background: var(--surface);
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.25s ease;
	}

	.card:hover,
	.card:focus-within {
		border-color: var(--accent);
		box-shadow:
			0 0 0 1px rgba(255, 0, 255, 0.35),
			0 0 28px rgba(255, 0, 255, 0.14);
	}

	.card:hover .tab-dot,
	.card:focus-within .tab-dot {
		background: var(--accent);
	}

	.featured {
		display: flex;
		flex-direction: column;
	}

	.diagram-col {
		min-width: 0;
		padding: 28px 28px 0;
	}

	.small {
		margin: 0;
		font-size: 13px;
		color: var(--fg-muted);
	}

	.shot-lg {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		border: 1px solid rgba(224, 255, 255, 0.16);
		border-radius: 2px;
		object-fit: cover;
	}

	.info-col {
		min-width: 0;
		padding: 28px;
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		grid-template-areas:
			'tab tab'
			'title meta'
			'body meta'
			'body actions';
		gap: 16px clamp(32px, 6vw, 72px);
		align-items: start;
	}

	.info-col .tab { grid-area: tab; }
	.info-col .title-lg { grid-area: title; }
	.info-col .body-lg { grid-area: body; max-width: 62ch; }
	.info-col .meta-lg { grid-area: meta; }
	.info-col .actions { grid-area: actions; margin-top: 0; align-self: end; }

	@media (max-width: 760px) {
		.info-col {
			display: flex;
			flex-direction: column;
			gap: 20px;
		}
	}

	.more summary {
		cursor: pointer;
		min-height: 44px;
		display: flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--fg-muted);
	}

	.more summary:hover {
		color: var(--fg);
	}

	.more .meta {
		padding-top: 4px;
	}

	.tab {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--fg-muted);
	}

	.file {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.tab-dot {
		width: 6px;
		height: 6px;
		background: rgba(224, 255, 255, 0.4);
		transition: background-color 0.25s ease;
	}

	h3 {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 500;
		color: var(--fg);
	}

	.title-lg {
		font-size: 26px;
		line-height: 1.2;
	}

	.title-md {
		font-size: 22px;
		line-height: 1.25;
	}

	.body-lg,
	.body-md {
		margin: 0;
		line-height: 1.65;
		color: var(--fg-soft);
	}

	.body-lg {
		font-size: 16px;
	}

	.body-md {
		font-size: 15px;
	}

	.meta {
		margin: 0;
		display: grid;
		grid-template-columns: 90px minmax(0, 1fr);
		gap: 8px 16px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--fg-soft);
	}

	.meta-lg {
		grid-template-columns: 110px minmax(0, 1fr);
		gap: 10px 16px;
	}

	.meta dt {
		color: var(--fg-dim);
	}

	.meta dd {
		margin: 0;
	}

	.meta dd.strong {
		color: var(--fg);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: auto;
		padding-top: 8px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 16px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--fg);
		text-decoration: none;
		border: 1px solid var(--border-soft);
		border-radius: 2px;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.btn:hover,
	.btn:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
		box-shadow: 0 0 18px rgba(255, 0, 255, 0.18);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
		gap: 24px;
	}

	.compact {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 28px;
	}

	.shot {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		height: auto;
		border: 1px solid rgba(224, 255, 255, 0.16);
		border-radius: 2px;
		object-fit: cover;
	}

	.push {
		align-self: flex-start;
		margin-top: auto;
	}
</style>
