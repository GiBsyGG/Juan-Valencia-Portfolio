---
const enlaces = [
	{ prefijo: 'github/', valor: '[usuario]', url: '[URL-GITHUB]', flecha: '↗' },
	{ prefijo: 'linkedin/', valor: '[usuario]', url: '[URL-LINKEDIN]', flecha: '↗' },
	{ prefijo: 'descargar/', valor: 'cv.pdf', url: '[URL-CV]', flecha: '↓' },
];
---

<section id="contacto" aria-labelledby="contacto-title" class="section">
	<div class="reveal inner">
		<div class="copy">
			<p class="eyebrow"><span class="num" data-section-num="contacto">03</span> // contacto</p>
			<h2 id="contacto-title">&gt; iniciar_conversación()</h2>
			<p class="lead">¿Tienes un proyecto, una vacante o un sistema que necesita arquitectura? Escríbeme y respondo con gusto.</p>
			<a class="btn mail" href="mailto:[tu@email.com]">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"></rect><path d="M3.5 6l8.5 7 8.5-7"></path></svg>
				[tu@email.com]
			</a>
			<ul class="links">
				{enlaces.map((e) => (
					<li>
						<a href={e.url}>
							<span><span class="prefix">{e.prefijo}</span>{e.valor}</span>
							<span aria-hidden="true">{e.flecha}</span>
						</a>
					</li>
				))}
			</ul>
		</div>

		<form class="form">
			<p class="form-title">nuevo_mensaje.sh</p>
			<div class="field">
				<label for="pf-name">--nombre</label>
				<input id="pf-name" type="text" autocomplete="name" placeholder="Tu nombre" />
			</div>
			<div class="field">
				<label for="pf-email">--email</label>
				<input id="pf-email" type="email" autocomplete="email" placeholder="tu@correo.com" />
			</div>
			<div class="field">
				<label for="pf-msg">--mensaje</label>
				<textarea id="pf-msg" rows="5" placeholder="Cuéntame sobre el proyecto…"></textarea>
			</div>
			<button class="submit" type="button">
				enviar --ahora
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
			</button>
		</form>
	</div>
</section>

<style>
	.section {
		padding: clamp(96px, 14vh, 160px) 0 clamp(80px, 12vh, 120px);
		border-top: 1px solid var(--border);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(40px, 6vw, 80px);
	}

	.copy {
		flex: 1 1 380px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--fg-muted);
	}

	.num.is-active {
		color: var(--accent);
	}

	h2 {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: clamp(28px, 3.4vw, 40px);
		line-height: 1.15;
		letter-spacing: -0.015em;
		color: var(--fg);
	}

	.lead {
		margin: 0;
		max-width: 460px;
		font-size: 17px;
		line-height: 1.65;
		color: var(--fg-soft);
	}

	.btn,
	.submit {
		color: var(--fg);
		border: 1px solid var(--border-soft);
		border-radius: 2px;
		font-family: var(--font-mono);
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.btn:hover,
	.btn:focus-visible,
	.submit:hover,
	.submit:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
		box-shadow: 0 0 18px rgba(255, 0, 255, 0.18);
	}

	.mail {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 0 18px;
		font-size: 14px;
		text-decoration: none;
	}

	.links {
		list-style: none;
		margin: 8px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		font-family: var(--font-mono);
		font-size: 14px;
		border-top: 1px solid rgba(224, 255, 255, 0.08);
	}

	.links li {
		border-bottom: 1px solid rgba(224, 255, 255, 0.08);
	}

	.links a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		min-height: 48px;
		color: var(--fg-soft);
		text-decoration: none;
	}

	.links a:hover {
		color: var(--accent);
	}

	.prefix {
		color: var(--fg-dim);
	}

	.form {
		flex: 1 1 420px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 28px;
		border: 1px solid var(--border);
		border-radius: 2px;
		background: var(--surface);
		font-family: var(--font-mono);
	}

	.form-title {
		margin: 0 0 4px;
		font-size: 12px;
		color: var(--fg-muted);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	label {
		font-size: 12px;
		color: var(--fg-muted);
	}

	input,
	textarea {
		padding: 0 12px;
		background: var(--bg);
		color: var(--fg);
		border: 1px solid rgba(224, 255, 255, 0.2);
		border-radius: 2px;
		font: inherit;
		font-size: 14px;
	}

	input {
		min-height: 44px;
	}

	textarea {
		padding: 12px;
		resize: vertical;
	}

	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 1px rgba(255, 0, 255, 0.35);
	}

	.submit {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 0 20px;
		background: transparent;
		color: var(--accent);
		border-color: var(--accent);
		font-size: 14px;
		cursor: pointer;
	}

	.submit:hover,
	.submit:focus-visible {
		background: var(--accent);
		color: var(--bg);
	}
</style>
